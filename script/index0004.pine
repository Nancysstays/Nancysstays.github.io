showMa = input.bool(false, "Show MA, LinReg, and VWMA", "ma_change, etc.", group = "MA, LinReg, and VWMA", inline = "MLV")
countMa = input.int(0, "Count of MA Labels", group = "MA, LinReg, and VWMA", inline = "MLV")
_ma = map.new<string, float>()
_ma.put("jinx_close", close)
_ma.put("ma_change", ma_change)
_ma.put("ma_crossover", l)
_ma.put("ma_crossunder", h)
_ma.put("vwma_crossover", l)
_ma.put("vwma_crossunder", h)
_ma.put("linreg_crossover", l)
_ma.put("linreg_crossunder", h)

if showMa
    switch
        // barstate.islast => label.new(bar_index, close, str.tostring(_ma.get("jinx_close")), color = color.white, tooltip = "jinx_close")
        ma_crossover => label.new(bar_index, close, str.tostring(_ma.get("ma_crossover")), tooltip = "ma_crossover:" + str.tostring(ma_crossover), color = color.green, style = label.style_label_lower_right)
        ma_crossunder => label.new(bar_index, close, str.tostring(_ma.get("ma_crossunder")), tooltip = "ma_crossunder:" + str.tostring(ma_crossunder), color = color.red, style = label.style_label_upper_right)
    switch
        vwma_crossover => label.new(bar_index, close, str.tostring(_ma.get("vwma_crossover")), tooltip = "vwma_crossover:" + str.tostring(vwma_crossover), color = color.green, style = label.style_label_lower_right)
        vwma_crossunder => label.new(bar_index, close, str.tostring(_ma.get("vwma_crossunder")), tooltip = "vwma_crossunder:" + str.tostring(vwma_crossunder), color = color.red, style = label.style_label_upper_right)
    switch
        linreg_crossover => label.new(bar_index, close, str.tostring(_ma.get("linreg_crossover")), tooltip = "linreg_crossover:" + str.tostring(linreg_crossover), color = color.green, style = label.style_label_lower_right)
        linreg_crossunder => label.new(bar_index, close, str.tostring(_ma.get("linreg_crossunder")), tooltip = "linreg_crossunder:" + str.tostring(linreg_crossunder), color = color.red, style = label.style_label_upper_right)

// End //////////////////////////////////////////////////////////////////////

// Function to determine if a new trading day has started
isNewDay() =>
    dayofmonth != dayofmonth[1]

// Function to count buy trades
countBuyTrades() =>
    buyTrade = strategy.opentrades.entry_id(strategy.opentrades - 1) == "Buy" // Assuming "Buy" is the ID used for buy entry orders
    buyTrade

// Function to count sell trades
countSellTrades() =>
    sellTrade = strategy.opentrades.entry_id(strategy.opentrades - 1) == "Sell" // Assuming "Sell" is the ID used for sell entry orders
    sellTrade
    
// Initialize variables
var int dailyBuyTrades  = 0
var int dailySellTrades = 0

// Check for new day
if isNewDay()
    // Reset daily counters
    dailyBuyTrades  := 0
    dailySellTrades := 0

// Count trades for the current bar
dailyBuyTrades  := dailyBuyTrades + (countBuyTrades() ? 1 : 0)
dailySellTrades := dailySellTrades + (countSellTrades() ? 1 : 0)

// Calculate total trades
dailyTotalTrades = dailyBuyTrades + dailySellTrades

// Plot results
plot(dailyBuyTrades, title="Daily Buy Trades", color=color.green, display = display.data_window)
plot(dailySellTrades, title="Daily Sell Trades", color=color.red, display = display.data_window)
plot(dailyTotalTrades, title="Daily Total Trades", color=color.blue, display = display.data_window)
showTrades = input.bool(true, "Show Trades")
// Display a table with the results
var table resultsTable = table.new(position.bottom_right, 2, 3)
if barstate.islast and showTrades
    table.cell(resultsTable, 0, 0, "Buy Trades",  bgcolor=color.green)
    table.cell(resultsTable, 1, 0, str.tostring(dailyBuyTrades), bgcolor=color.green)
    table.cell(resultsTable, 0, 1, "Sell Trades", bgcolor=color.red)
    table.cell(resultsTable, 1, 1, str.tostring(dailySellTrades), bgcolor=color.red)
    table.cell(resultsTable, 0, 2, "Total Trades", bgcolor=color.blue)
    table.cell(resultsTable, 1, 2, str.tostring(dailyTotalTrades), bgcolor=color.blue)

