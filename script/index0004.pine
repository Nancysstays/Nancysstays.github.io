//     exitCondition => strategy.close("Long")

// --- Entry/Exit Conditions ---
// --- Strategy Logic ---
bool long_signal2 = lrs < cl and lrl < lrs // and p_uu > 0.5
bool short_signal2 = lrs > cl and lrl > lrs // and p_dd > 0.5

// --- Identify Divergences ---
bool bullish_div = low > low[1] and swing_price_ratio > swing_price_ratio[lookback]
bool bearish_div = high < high[1] and swing_price_ratio < swing_price_ratio[lookback]

bool long_signal1 = latest_lr_data.shortLR > cl and latest_lr_data.longLR < latest_lr_data.shortLR
bool short_signal1 = latest_lr_data.shortLR < cl and latest_lr_data.longLR > latest_lr_data.shortLR

bool longCondition = ta.crossover(Macd.macdLine, Macd.signalLine) and covariance_tsla_dow > 0 // and covariance_short_tsla_dow > 0
bool shortCondition = ta.crossunder(Macd.macdLine, Macd.signalLine) and covariance_tsla_dow < 0 // and covariance_short_tsla_dow < 0

bool removeLongs = input.bool(true)
bool removeShorts = input.bool(true)

// Entry and exit conditions
switch
    long_signal > entryThreshold and entrya and removeLongs => strategy.entry("Long MLA", strategy.long, alert_message = "{{strategy.order}}")
    short_signal < -1 * entryThreshold and entrya and removeShorts => strategy.entry("Short MLA", strategy.short, alert_message = "{{strategy.order}}")

switch
    long_signal1 and entryb and removeLongs => strategy.entry("Long ABS Alpha", strategy.long, alert_message = "{{strategy.order}}", oca_type = strategy.oca.cancel)
    short_signal1 and entryb and removeShorts => strategy.entry("Short ABS Alpha", strategy.short, alert_message = "{{strategy.order}}", oca_type = strategy.oca.cancel)

switch
    long_signal2 and entryc and removeLongs => strategy.entry("Long ABS Beta", strategy.long, alert_message = "{{strategy.order}}", oca_type = strategy.oca.cancel)
    short_signal2 and entryc and removeShorts => strategy.entry("Short ABS Beta", strategy.short, alert_message = "{{strategy.order}}", oca_type = strategy.oca.cancel)

switch
    longCondition and entryd and removeLongs => strategy.entry("Long: Cov & MACD", strategy.long)
    shortCondition and entryd and removeShorts => strategy.entry("Short: Cov & MACD", strategy.short)

switch
    bullish_div and entrye and removeLongs => strategy.entry("Long: Bull", strategy.long, alert_message = "{{strategy.order}}", oca_type = strategy.oca.cancel)
    bearish_div and entrye and removeShorts => strategy.entry("Short: Bear", strategy.short, alert_message = "{{strategy.order}}", oca_type = strategy.oca.cancel)

// switch
