timeframeInput = input.timeframe("D", "Box Timeframe", ["D", "240", "60", "15"], "boxCount")

// Input for the number of boxes to display
boxCount = input.int(20, minval=1, title="Box Count")

// Function to draw a new box
drawBox(bar b, right) =>
    color boxColor = b.c >= b.o ? color.green : color.red
    box.new(b.t, b.h, right, b.l, boxColor, xloc = xloc.bar_time, bgcolor = color.new(boxColor, 10))

// Function to update an existing box
updateBox(box boxId, bar b) =>
    color boxColor = b.c >= b.o ? color.green : color.red
    box.set_border_color(boxId, boxColor)
    box.set_bgcolor(boxId, color.new(boxColor, 75))
    box.set_top(boxId, b.h)
    box.set_bottom(boxId, b.l)
    box.set_right(boxId, time)

// Get higher timeframe bar data
secBar = request.security(syminfo.tickerid, timeframeInput, bar.new())

// Keep track of the boxes created
var box[] boxes = array.new_box()

if not na(secBar)
    // Check if a new higher timeframe bar has closed
    if timeframe.change(timeframeInput)
        // Remove old boxes if the number of boxes exceeds the limit
        if array.size(boxes) >= boxCount
            for i = 0 to array.size(boxes) - boxCount - 1
                box.delete(array.get(boxes, i))
            array.remove(boxes, array.size(boxes) - boxCount)

        // Draw a new box for the closed higher timeframe bar
        array.push(boxes, drawBox(secBar, time[1]))
    else
        // Update the last box with the current higher timeframe bar data
        if array.size(boxes) > 0
            updateBox(array.get(boxes, array.size(boxes) - 1), secBar)

// End /////////////////////////////////////////

sensitivity = input.float(title="Sensitivity", defval=1.0, minval=0.1, maxval=3.0)
regressionLength = input.int(title="Regression Length", defval=10, minval=5)

// Custom cosh function using exp notation
// cosh(x) =>
//     // x_ = array.get(x, 0)
//     (math.exp(x) + math.exp(-x)) / 2

// Calculate the highest high and its index
highestHighIndex = bar_index - ta.highestbars(high, length)

// // Create arrays for storing x and y coordinates
// x = array.new_int(0)
// y = array.new_float(0)

// Calculate the average closing price
avgClose = ta.sma(close, length)
ax = array.new<int>(0)
ay = array.new<float>(0)
// Add the bar index and closing price of relevant points to the arrays
for i = highestHighIndex to bar_index
    // Apply sensitivity to filter points
    if math.abs(close[bar_index - i] - avgClose) >= sensitivity * ta.stdev(close, length)
        array.push(ax, i)
        array.push(ay, close[bar_index - i])

// Perform cosh regression analysis on the last 'regressionLength' points
float[] coeffs = array.new_float(0)
if array.size(ax) >= regressionLength
    int[] x_reg = array.slice(ax, array.size(ax) - regressionLength, array.size(ax))
    float[] y_reg = array.slice(ay, array.size(ay) - regressionLength, array.size(ay))
    // array.push(coeffs, cosh(y_reg)) // Still using built-in ta.cosh here, as custom implementation of regression is complex

// Generate the fitted curve points using custom cosh function
float[] fittedY = array.new_float(0)
if array.size(coeffs) == 3
    for i = 0 to array.size(ax) - 1
        float xi = array.get(ax, i)
        // float fitted = array.get(coeffs, 0) * cosh(array.get(coeffs, 1) * xi + array.get(coeffs, 2)) 
        // array.push(fittedY, fitted)

// Draw the curved polyline
// plot(array.get(y, 0), title="Curved Polyline", color=color.blue, linewidth=2, style=plot.style_line)

// Draw the fitted curve
// plot(array.get(fittedY, 0), title="Cosh Regression", color=color.red, linewidth=2, style=plot.style_line)

// Add label for the cosh regression analysis
if array.size(coeffs) == 3
    label.new(bar_index, highestHigh, "Cosh Regression: " + str.tostring(coeffs[0]) + "*cosh(" + str.tostring(coeffs[1]) + "*x + " + str.tostring(coeffs[2]) + ")", color=color.red, style=label.style_label_down)

// End /////////////////////////////////////////

