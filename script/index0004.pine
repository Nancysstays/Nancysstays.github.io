alertcondition(math.abs(close - average_stdev) > average_stdev * stdev_multiplier , title = "Price is more than Multiplied Stdev away from average stdev", message = "Price is more than Multiplied Stdev away from average stdev")
alertcondition(long_signal > entryThreshold, title="Long Entry Alert", message="Long Entry Signal. There were {{plot('Daily Buy Trades')}} buy trades today.")
alertcondition(short_signal < entryThreshold * -1, title="Short Entry Alert", message="Short Entry Signal. There were {{plot('Daily Sell Trades')}} sell trades today.")

