var color active = color.new(color.yellow, 10)
var color inactive = color.new(color.white, 10)

// Display the probabilities
plot(uCount, "# Up", precision = 0, display = display.data_window+display.status_line, color = math.max(uCount, dCount) == uCount ? active : inactive)
plot(p_u, "P(Up)", precision = 3, display = display.data_window+display.status_line, color = math.max(p_u, p_d) == p_u ? color.green : inactive)
plot(dCount, "# Down", precision = 0, display = display.data_window+display.status_line, color = math.max(uCount, dCount) == dCount ? active : inactive)
plot(p_d, "P(Down)", precision = 3, display = display.data_window+display.status_line, color = math.max(p_u, p_d) == p_d ? color.green : inactive)
plot(uuCount, "# Up | Up", precision = 0, display = display.data_window+display.status_line, color = math.max(uuCount, udCount, duCount, ddCount) == uuCount ? active : inactive)
plot(p_uu, "P(Up | Up)", precision = 3, display = display.data_window+display.status_line, color = math.max(p_u, p_d, p_uu, p_ud, p_du, p_dd) == p_uu ? color.green : inactive)
plot(udCount, "# Down | Up", precision = 0, display = display.data_window+display.status_line, color = math.max(uuCount, udCount, duCount, ddCount) == udCount ? active : inactive)
plot(p_ud, "P(Down | Up)", precision = 3, display = display.data_window+display.status_line, color = math.max(p_u, p_d, p_uu, p_ud, p_du, p_dd) == p_ud ? color.green : inactive)
plot(duCount, "# Up | Down", precision = 0, display = display.data_window+display.status_line, color = math.max(uuCount, udCount, duCount, ddCount) == duCount ? active : inactive)
plot(p_du, "P(Up | Down)", precision = 3, display = display.data_window+display.status_line, color = math.max(p_u, p_d, p_uu, p_ud, p_du, p_dd) == p_du ? color.green : inactive)
plot(ddCount, "# Down | Down", precision = 0, display = display.data_window+display.status_line, color = math.max(uuCount, udCount, duCount, ddCount) == ddCount ? active : inactive)
plot(p_dd, "P(Down | Down)", precision = 3, display = display.data_window+display.status_line, color = math.max(p_u, p_d, p_uu, p_ud, p_du, p_dd) == p_dd ? color.green : inactive)

// 1/6/25 /////////////////////////////////////

// indicator(title="Standard Deviations Between Extrema", shorttitle="StDev Extrema", overlay=true)

// Input options
source = close
stdev_multiplier = input.float(title="StDev Multiplier", defval=2.0)

// Parameters for finding peaks and troughs (adjust as needed)
len = input.int(10, title="Pivot Length")

// Find peaks and troughs
highs = ta.pivothigh(src, len, len)
lows = ta.pivotlow(src, len, len)

// Store peak and trough values and bar indices in arrays
var peakValues = array.new_float()
var peakIndices = array.new_int()
var troughValues = array.new_float()
var troughIndices = array.new_int()

// Add new peaks and troughs to arrays
if not na(highs)
    array.push(peakValues, highs)
    array.push(peakIndices, bar_index - len)
if not na(lows)
    array.push(troughValues, lows)
    array.push(troughIndices, bar_index - len)

// Find the starting index of your data (replace with your actual logic)
// This example assumes data recording starts at bar_index 50
startIndex = 50 

// Function to find the first element in an array with an index greater than or equal to the start index
findFirstIndexGreaterThanOrEqual(arrIndices, startIndex) =>
    minIndex = -1
    for i = 0 to array.size(arrIndices) - 1
        if array.get(arrIndices, i) >= startIndex
            minIndex = i
            break
    minIndex

// Get the starting indices for peaks and troughs
firstPeakIndex = findFirstIndexGreaterThanOrEqual(peakIndices, startIndex)
firstTroughIndex = findFirstIndexGreaterThanOrEqual(troughIndices, startIndex)

// // Plot lines between peaks, starting from the first peak after startIndex
// if firstPeakIndex != -1 and array.size(peakValues) > firstPeakIndex + 1
//     for i = firstPeakIndex to array.size(peakValues) - 2
//         line.new(array.get(peakIndices, i), array.get(peakValues, i), array.get(peakIndices, i+1), array.get(peakValues, i+1), color=color.blue, width = 2)
// 
// // Plot lines between troughs, starting from the first trough after startIndex
// if firstTroughIndex != -1 and array.size(troughValues) > firstTroughIndex + 1
//     for i = firstTroughIndex to array.size(troughValues) - 2
//         line.new(array.get(troughIndices, i), array.get(troughValues, i), array.get(troughIndices, i+1), array.get(troughValues, i+1), color=color.orange, width = 2)

// // Plot the pivots (optional)
// plot(highs, style=plot.style_cross, color=color.blue, linewidth=3, offset=-len)
// plot(lows, style=plot.style_cross, color=color.orange, linewidth=3, offset=-len)

// // Example of how to visualize startIndex (optional)
// plotchar(startIndex, "Start Index", "", location.bottom, color=color.green, size=size.tiny)

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// Function to find extrema (peaks and troughs)
find_extrema(src, len) =>
    high_peaks = array.new_float()
    low_troughs = array.new_float()
    for i = 1 to len - 2
        if src[i] > src[i - 1] and src[i] > src[i + 1]
            array.push(high_peaks, src[i])
        if src[i] < src[i - 1] and src[i] < src[i + 1]
            array.push(low_troughs, src[i])
    [high_peaks, low_troughs]

// Find extrema within the lookback period
[peaks, troughs] = find_extrema(source, lookback)

// Calculate standard deviations between extrema
stdevs = array.new_float()
if array.size(peaks) > 1
    for i = 0 to array.size(peaks) - 2
        diff = math.abs(array.get(peaks, i + 1) - array.get(peaks, i))
        array.push(stdevs, ta.stdev(source, lookback)) // Use stdev of source over lookback
if array.size(troughs) > 1
    for i = 0 to array.size(troughs) - 2
        diff = math.abs(array.get(troughs, i + 1) - array.get(troughs, i))
        array.push(stdevs, ta.stdev(source, lookback)) // Use stdev of source over lookback

// Plot extrema
plotshape(array.size(peaks) > 0 and array.size(peaks) <= 2 ? array.get(peaks, array.size(peaks) - 1) : na, title="Peaks", style = shape.triangleup, color=color.green, location = location.belowbar)
plotshape(array.size(troughs) > 0 and array.size(troughs) <= 2 ? array.get(troughs, array.size(troughs) - 1) : na, title="Troughs", style = shape.triangledown, color=color.red, location = location.abovebar)

//Plot Stdevs as lines between extrema
if array.size(peaks) > 1
    for i = 0 to array.size(peaks) - 2
        line.new(bar_index[i], array.get(peaks, i), bar_index[i+1], array.get(peaks, i+1), color=color.blue, width = 2)

if array.size(troughs) > 1
    for i = 0 to array.size(troughs) - 2
        line.new(bar_index[i], array.get(troughs, i), bar_index[i+1], array.get(troughs, i+1), color=color.orange, width = 2)

// Plot average stdev and multiplied stdev
average_stdev = array.size(stdevs) > 0 ? array.avg(stdevs) : na
plot(average_stdev, title="Average StDev", display = display.data_window)
plot(average_stdev * stdev_multiplier, title="Multiplied StDev", display = display.data_window)

// next /////////////////////////////////////

// Input options
percentage_high = input.float(title="High Percentile (%)", defval=99.0, minval=0.0, maxval=100.0)
percentage_low = input.float(title="Low Percentile (%)", defval=1.0, minval=0.0, maxval=100.0)

// Function to calculate percentile using linear interpolation (Pine Script v5)
percentile_linear_interpolation(src, len, percent) =>
    sorted_src = array.sort(array.from(src))
    array_len = array.size(sorted_src)
    if array_len == 0
        na
    else
        index = (percent / 100) * (array_len - 1)
        if index < 0
            array.get(sorted_src, 0)
        else if index >= array_len - 1
            array.get(sorted_src, array_len - 1)
        else
            int_index = math.floor(index)
            frac_index = index - int_index
            val1 = array.get(sorted_src, int_index)
            val2 = array.get(sorted_src, int_index + 1)
            val1 + frac_index * (val2 - val1)

// Calculate high and low percentiles
// high_percentile = percentile_linear_interpolation(source, length, percentage_high)
// low_percentile = percentile_linear_interpolation(source, length, percentage_low)
high_percentile = ta.percentile_linear_interpolation(source, length, percentage_high)
low_percentile = ta.percentile_linear_interpolation(source, length, percentage_low)


// Plot the percentiles
plot(high_percentile, color=color.new(color.green, 75), title="High Percentile", display = display.data_window+display.price_scale)
plot(low_percentile, color=color.new(color.red, 75), title="Low Percentile", display = display.data_window+display.price_scale)

// Create a map/background color based on percentile position
bgcolor = if source > high_percentile
    color.new(color.green, 98) // Light green if above high percentile
else if source < low_percentile
    color.new(color.red, 98)   // Light red if below low percentile
else
    color.new(color.gray, 70)  // Light gray if within the range

bgcolor(bgcolor)

//Optional: Plot source
plot(source, color=color.blue, title="Source", display = display.data_window)

// End /////////////////////////////////////////

// --- Input Parameters ---
fastLength = input.int(20, title="Fast SMA Length")
slowLength = input.int(50, title="Slow SMA Length")
initialCapital = input.float(10000, title="Initial Capital")

// --- Calculate Indicators ---
fastSMA = ta.sma(close, fastLength)
slowSMA = ta.sma(close, slowLength)

// --- Trade Counter ---
var tradeCount = 0 
var lastTradeDay = 0

// Increment trade counter on entry/exit
if (ta.crossover(fastSMA, slowSMA) or ta.crossunder(fastSMA, slowSMA))
    if tradeCount < 3
        tradeCount := tradeCount + 1
        lastTradeDay := dayofweek

// Decrement trade counter if no trade today and counter is greater than 0
if (dayofweek != lastTradeDay and tradeCount > 0)
    tradeCount := tradeCount - 1

// --- Time Filter ---
tradingHour = hour(time)
allowedTime = tradingHour >= 4 and tradingHour < 17

// --- Profit Calculation ---
var float profit = 0
// var float lastEntryPrice = 0

if (strategy.position_size > 0 and lastEntryPrice == 0)  // Entering a new trade
    lastEntryPrice := strategy.position_avg_price

if (strategy.position_size == 0 and lastEntryPrice != 0)  // Exiting a trade
    profit := profit + (strategy.position_avg_price - lastEntryPrice) * strategy.position_size  // Calculate profit/loss
    lastEntryPrice := 0  // Reset entry price

// --- Display Information ---
cin = input.int(100, options = [0,50,100])
fmediumSMA = ta.sma(close, lookback /4)
mediumSMA = ta.sma(close, lookback /2)
smediumSMA = ta.sma(close, int(lookback/1.75))
plot(fastSMA, color = fastSMA > slowSMA ?  close > close[1] and close[1] > close[2]? color.teal : color.new(color.white, 00) : close > close[1] and lrs < lrl ? color.new(color.maroon, 50) : color.maroon, title="Fast SMA")
plot(slowSMA, color=color.red, title="Slow SMA")

plotchar(tradeCount, title="Trade Counter", char="", location=location.abovebar, color=color.white, size=size.small)

// --- Account Balance and Profit ---
accountBalance = initialCapital + profit
plot(accountBalance, title="Account Balance", display = display.data_window)
plot(profit, title="Profit", display = display.data_window)

// End /////////////////////////////////////////
