// --- Variance and Covariance ---

// Calculate variance using ta.variance
price_variance = ta.variance(cl, length)

// Create arrays for covariance calculation
var close_prices = array.new_float(length)
var ma_values = array.new_float(length)
for i = 0 to length - 1
    array.set(close_prices, i, cl[i])
    array.set(ma_values, i, ma[i])

// Calculate covariance
