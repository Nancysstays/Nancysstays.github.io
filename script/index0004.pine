// --- Calculate and display probabilities in a table ---

// Function to populate table cells with pattern and probability
populateTableCell(tbl, row, pattern, probability) =>
    table.cell(tbl, 0, row, pattern, text_color=color.white)
    table.cell(tbl, 1, row, str.tostring(probability * 100, "#.##") + "%", text_color=color.white)

var table probabilitiesTable = table.new(position.bottom_right, 2, 69)

bool showProbabilities2 = input.bool(false, "Probability Table 2")
bool showProbabilities3 = input.bool(false, "Probability Table 3", "1 Bar, 2 Bar and 3 Bar")
bool showProbabilities4 = input.bool(true, "Probability Table 4", "4 Bar")
bool showProbabilities5 = input.bool(false, "Probability Table 5", "5 Bar")

if barstate.islast and showProbabilities2
    if showProbabilities3
        table.cell(probabilitiesTable, 0, 0, "Pattern", text_color=color.white, bgcolor=color.gray)
        table.cell(probabilitiesTable, 1, 0, "Probability", text_color=color.white, bgcolor=color.gray)

        // Populate table using the function and a matrix-like approach
        // 1-Bar Patterns
        populateTableCell(probabilitiesTable, 1, "U", prob_u)
        populateTableCell(probabilitiesTable, 2, "D", prob_d)

        // 2-Bar Patterns
        populateTableCell(probabilitiesTable, 3, "UU", prob_uu)
        populateTableCell(probabilitiesTable, 4, "UD", prob_ud)
        populateTableCell(probabilitiesTable, 5, "DU", prob_du)
        populateTableCell(probabilitiesTable, 6, "DD", prob_dd)

        // 3-Bar Patterns
        populateTableCell(probabilitiesTable, 7, "UUU", prob_uuu)
        populateTableCell(probabilitiesTable, 8, "UUD", prob_uud)
        populateTableCell(probabilitiesTable, 9, "UDU", prob_udu)
        populateTableCell(probabilitiesTable, 10, "UDD", prob_udd)
        populateTableCell(probabilitiesTable, 11, "DUU", prob_duu)
        populateTableCell(probabilitiesTable, 12, "DUD", prob_dud)
        populateTableCell(probabilitiesTable, 13, "DDU", prob_ddu)
        populateTableCell(probabilitiesTable, 14, "DDD", prob_ddd)

    if showProbabilities4
        // 4-Bar Patterns
        populateTableCell(probabilitiesTable, 15, "UUUU", prob_uuuu)
        populateTableCell(probabilitiesTable, 16, "UUUD", prob_uuud)
        populateTableCell(probabilitiesTable, 17, "UUDU", prob_uudu)
        populateTableCell(probabilitiesTable, 18, "UUDD", prob_uudd)
        populateTableCell(probabilitiesTable, 19, "UDUU", prob_uduu)
        populateTableCell(probabilitiesTable, 20, "UDUD", prob_udud)
        populateTableCell(probabilitiesTable, 21, "UDDU", prob_uddu)
        populateTableCell(probabilitiesTable, 22, "UDDD", prob_uddd)
        populateTableCell(probabilitiesTable, 23, "DUUU", prob_duuu)
        populateTableCell(probabilitiesTable, 24, "DUUD", prob_duud)
        populateTableCell(probabilitiesTable, 25, "DUDU", prob_dudu)
        populateTableCell(probabilitiesTable, 26, "DDUD", prob_ddud)
        populateTableCell(probabilitiesTable, 27, "DDUU", prob_dduu)
        populateTableCell(probabilitiesTable, 28, "DDDU", prob_dddu)
        populateTableCell(probabilitiesTable, 29, "DDDD", prob_dddd)

    if showProbabilities5
        // 5-Bar Patterns
        populateTableCell(probabilitiesTable, 30, "UUUUU", prob_uuuuu)
        populateTableCell(probabilitiesTable, 31, "UUUUD", prob_uuuud)
        populateTableCell(probabilitiesTable, 32, "UUUDU", prob_uuudu)
        populateTableCell(probabilitiesTable, 33, "UUUDD", prob_uuudd)
        populateTableCell(probabilitiesTable, 34, "UUDUU", prob_uuduu)
        populateTableCell(probabilitiesTable, 35, "UUDUD", prob_uudud)
        populateTableCell(probabilitiesTable, 36, "UUDDU", prob_uuddu)
        populateTableCell(probabilitiesTable, 37, "UUDDD", prob_uuddd)
        populateTableCell(probabilitiesTable, 38, "UDUUU", prob_uduuu)
        populateTableCell(probabilitiesTable, 39, "UDUU", prob_uduu)
        populateTableCell(probabilitiesTable, 40, "UDUUD", prob_uduud)
        populateTableCell(probabilitiesTable, 41, "UDUDU", prob_ududu)
        populateTableCell(probabilitiesTable, 42, "UDUDD", prob_ududd)
        populateTableCell(probabilitiesTable, 43, "UDDUU", prob_udduu)
        populateTableCell(probabilitiesTable, 44, "UDDUD", prob_uddud)
        populateTableCell(probabilitiesTable, 45, "UDDDU", prob_udddu)
        populateTableCell(probabilitiesTable, 46, "UDDDD", prob_udddd)
        populateTableCell(probabilitiesTable, 47, "DUUUU", prob_duuuu)
        populateTableCell(probabilitiesTable, 48, "DUUU", prob_duuu)
        populateTableCell(probabilitiesTable, 49, "DUUUD", prob_duuud)
        populateTableCell(probabilitiesTable, 50, "DUUDU", prob_duudu)
        populateTableCell(probabilitiesTable, 51, "DUUDD", prob_duudd)
        // populateTableCell(probabilitiesTable, 52, "DUDUU", prob_duduu)
        populateTableCell(probabilitiesTable, 53, "DUDUD", prob_dudud)
        populateTableCell(probabilitiesTable, 54, "DUDDU", prob_duddu)
        populateTableCell(probabilitiesTable, 55, "DUDDD", prob_duddd)
        populateTableCell(probabilitiesTable, 56, "DDUUU", prob_dduuu)
        populateTableCell(probabilitiesTable, 57, "DDUU", prob_dduu)
        populateTableCell(probabilitiesTable, 58, "DDUUD", prob_dduud)
        // populateTableCell(probabilitiesTable, 59, "DDUUD", prob_dduudu)
        // populateTableCell(probabilitiesTable, 60, "DDUUDD", prob_dduudd)
        populateTableCell(probabilitiesTable, 61, "DDUDU", prob_ddudu)
        // populateTableCell(probabilitiesTable, 62, "DDUDUD", prob_ddudud)
        // populateTableCell(probabilitiesTable, 63, "DDUDDU", prob_dduddu)
        // populateTableCell(probabilitiesTable, 64, "DDUDDD", prob_dduddd)
        populateTableCell(probabilitiesTable, 65, "DDDUU", prob_ddduu)
        // populateTableCell(probabilitiesTable, 66, "DDDUD", prob_dddud)
        // populateTableCell(probabilitiesTable, 67, "DDDDU", prob_ddddu)
        populateTableCell(probabilitiesTable, 68, "DDDDD", prob_ddddd)
        // ... (previous code) ...
        populateTableCell(probabilitiesTable, 61, "DDUDU", prob_ddudu)
        // populateTableCell(probabilitiesTable, 62, "DDUDUD", prob_ddudud)
        // populateTableCell(probabilitiesTable, 63, "DDUDDU", prob_dduddu)
        // populateTableCell(probabilitiesTable, 64, "DDUDDD", prob_dduddd)
        populateTableCell(probabilitiesTable, 65, "DDDUU", prob_ddduu)
        // populateTableCell(probabilitiesTable, 66, "DDDUD", prob_dddud)
        // populateTableCell(probabilitiesTable, 67, "DDDDU", prob_ddddu)
        populateTableCell(probabilitiesTable, 68, "DDDDD", prob_ddddd)

// ... (rest of the script, if any) ...


