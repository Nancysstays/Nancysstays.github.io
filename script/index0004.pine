//@type Open High Low Close data
//@field o Open
//@field h high
//@field l low
//@field c close
type Bar
    float o
    float h
    float l
    float c

type bar
    float o = open
    float h = high
    float l = low
    float c = close
    int t = time

// --- Type Definitions ---
//@type Type for the MACD
//@field macdLine - It shows the difference between two moving averages to identify momentum changes.
//@field signalLine - A moving average of the MACD line used to generate trading signals.
type SwingPoint
    int x
    float y

//@type Type for the MACD
//@field macdLine - It shows the difference between two moving averages to identify momentum changes.
//@field hist - Visualizes the difference between the MACD and signal line to show momentum strength.
type lastEntry
    float lastEntryPrice
    int lastEntryBar

// --- Type Definition for Linear Regression Data ---
//@type Type for the MACD
//@field macdLine - It shows the difference between two moving averages to identify momentum changes.
//@field signalLine - A moving average of the MACD line used to generate trading signals.
//@field hist - Visualizes the difference between the MACD and signal line to show momentum strength.
//@field hist - Visualizes the difference between the MACD and signal line to show momentum strength.
type LRData
    float shortLR
    float longLR
    float openLR
    float closeLR
    float extraLongLR

//@type Type for the MACD
//@field macdLine - It shows the difference between two moving averages to identify momentum changes.
//@field signalLine - A moving average of the MACD line used to generate trading signals.
//@field hist - Visualizes the difference between the MACD and signal line to show momentum strength.
type MACD
    float macdLine
    float signalLine
    float hist

//@type A point on a chart.
//@field index The index of the bar where the point is located, i.e., its `x` coordinate.
//@field price The price where the point is located, i.e., its `y` coordinate.
type Point
    int index
    float price

//@type Background Color of background
//@field row data combining to make the cellular data
//@field col data combining to make the cellular data
type Cell
    int row
    int col

//@type Background Color of background
//@field a first Background
//@field b second Background
//@field c third Background
//@field d fourth Background
type textArea
    string a
    string b
    string c
    string d

//@type Background Color of background
//@field a first Background
//@field b second Background
//@field c third Background
//@field d fourth Background
type Background
    string a
    string b
    string c
    string d

// --- Function to Determine Lower Timeframe ---
getLowerTimeframe(tf) =>
    switch tf
        "1" => "1" // 1 minute can't go lower
        "3" => "1" 
        "5" => "1"
        "15" => "5"
        "30" => "5"
        "60" => "15"
        "120" => "15"
        "240" => "15"
        "D" => "15" 
        "W" => "60"
        "M" => "60"
        "3M" => "60"
        "6M" => "D"
        "12M" => "D"
        => timeframe.period // Use default if no match

// --- Get and Set New Timeframe ---
newTimeframe = getLowerTimeframe(timeframe.period)

// --- Request Security Data with newTimeframe ---
[o, h, l, cl, v] = request.security(syminfo.ticker, newTimeframe, [open, high, low, close, volume])
[a_o, a_h, a_l, a_cl, a_v] = request.security_lower_tf(syminfo.ticker, newTimeframe, [open, high, low, close, volume])
na_0 = array.get(a_o, 0)
na_h = array.get(a_h, 0)
na_l = array.get(a_l, 0)
na_cl = array.get(a_cl, 0)
na_v = array.get(a_v, 0)

// Function to find the extreme bar index within a given range
get_extreme_bar_index(src, len, direction) =>
    var extreme_bar = 0
    var extreme_value = direction == "high" ? src[0] : -src[0]
    for i = 1 to len - 1
        current_value = direction == "high" ? src[i] : -src[i]
        if current_value > extreme_value
            extreme_value := current_value
            extreme_bar := i
    extreme_bar

// --- High/Low Detection ---

// Get highest and lowest bar indices
highest_bar_index = get_extreme_bar_index(h, lookback, "high")
lowest_bar_index = get_extreme_bar_index(l, lookback, "low")

// --- Swing Line Construction ---

var high_points_x = array.new_int()
var high_points_y = array.new_float()
var low_points_x = array.new_int()
var low_points_y = array.new_float()

var last_high_added = 0
var last_low_added = 0

for i = 1 to length >= 9999 ? 9999 : length
    if highest_bar_index[i] == 0 and i != last_high_added and array.size(high_points_x) < 99999
        array.push(high_points_x, bar_index[i])
        array.push(high_points_y, high[i])
        last_high_added := i

    if lowest_bar_index[i] == 0 and i != last_low_added and array.size(low_points_x) < 99999
        array.push(low_points_x, bar_index[i])
        array.push(low_points_y, low[i])
        last_low_added := i

// ... (your code for high/low detection and populating the arrays) ...

// Draw lines connecting the high and low points
if array.size(high_points_x) >= 20 and array.size(low_points_x) >= 2
    for i = 0 to math.min(array.size(high_points_x), array.size(low_points_x)) - 2
        high_x1 = array.get(high_points_x, i)
        // high_y1 = array.get(high_points_y, i)
        // low_x1 = array.get(low_points_x, i)
        // low_y1 = array.get(low_points_y, i)
        // line.new(x1=high_x1, y1=high_y1, x2=low_x1, y2=low_y1, color=color.blue, width=2)

    // Connect the last low to the next high (if available)
    if array.size(high_points_x) > array.size(low_points_x)
        last_low_x = array.get(low_points_x, array.size(low_points_x) - 1)
        // last_low_y = array.get(low_points_y, array.size(low_points_x) - 1)
        // last_high_x = array.get(high_points_x, array.size(high_points_x) - 1)
        // last_high_y = array.get(high_points_y, array.size(high_points_x) - 1)
        // line.new(x1=last_low_x, y1=last_low_y, x2=last_high_x, y2=last_high_y, color=color.blue, width=2)

// --- Swing Metrics and Information ---

// NEW SOURCE ///////////////////////////////////////////////////////////////////////////////////////////////

// --- Arrays for storing swing data ---
var _high_points_x = array.new_int()
var _high_points_y = array.new_float()
var _low_points_x = array.new_int()
var _low_points_y = array.new_float()
var _info_labels = array.new_label()

// --- Function to calculate distance ---
distance(x1, y1, x2, y2) =>
    math.sqrt(math.pow(x2 - x1, 2) + math.pow(y2 - y1, 2))

// --- Swing High/Low Detection ---
swing_high = ta.pivothigh(lookback, lookback)
swing_low = ta.pivotlow(lookback, lookback)

// --- Storing swing points in arrays ---
if not na(swing_high)
    array.push(_high_points_x, bar_index[lookback])
    array.push(_high_points_y, swing_high)

if not na(swing_low)
    array.push(_low_points_x, bar_index[lookback])
    array.push(_low_points_y, swing_low)

float swing_price_ratio = 0
float swing_distance_deviation = 0
float price_diff_deviation = 0
float avg_swing_distance = 0
float avg_price_diff = 0
bool extra_swings = input.bool(false, "Extra Swings", inline = "Swinger")

// --- Calculations and Label Creation ---
if array.size(_high_points_x) >= 2 and array.size(_low_points_x) >= 1
    for i = 0 to math.min(labelCount - 1, array.size(high_points_x) - 2)
        // Retrieve swing points from arrays
        high_x1 = array.get(_high_points_x, array.size(_high_points_x) - 2 - i)
        high_y1 = array.get(_high_points_y, array.size(_high_points_x) - 2 - i)
        low_x1 = array.get(_low_points_x, array.size(_low_points_x) - 1 - i)
        low_y1 = array.get(_low_points_y, array.size(_low_points_x) - 1 - i)
        high_x2 = array.get(_high_points_x, array.size(_high_points_x) - 1 - i)
        high_y2 = array.get(_high_points_y, array.size(_high_points_x) - 1 - i)

        // Calculate distances and price differences for previous swings
        swing_distance1 = distance(high_x1, high_y1, low_x1, low_y1)
        price_diff1 = high_y1 - low_y1

        swing_distance2 = distance(low_x1, low_y1, high_x2, high_y2)
        price_diff2 = high_y2 - low_y1

        // Calculate distances and price differences for current swing (if available)
        float swing_distance_current = na
        float price_diff_current = na
        if not na(swing_high) and not na(swing_low)
            swing_distance_current := distance(bar_index[lookback], swing_high, bar_index, swing_low)
            price_diff_current := swing_high - swing_low

        // Calculate averages
        avg_swing_distance := ta.sma(swing_distance_current, length)
        avg_price_diff := ta.sma(price_diff_current, length)

        // Calculate ratio
        swing_price_ratio := avg_swing_distance / avg_price_diff
        swing_distance_deviation := ta.stdev(swing_distance_current, length)
        price_diff_deviation := ta.stdev(price_diff_current, length)

        // Create info text for previous swings
        info_tooltip = "Swing " + str.tostring(i + 1) + ": \n" +
          "Distance = " + str.tostring(swing_distance1, "#.##") + " bars\n" +
          "Price Difference = " + str.tostring(price_diff1, "#.##") + "\n" +
          "Distance StDev = " + str.tostring(ta.stdev(swing_distance1, length), "#.##") + "\n" +
          "Price StDev = " + str.tostring(ta.stdev(price_diff1, length) / ta.highest(200), "#.##%") + "\n\n" +
          "Swing " + str.tostring(i + 2) + ": \n" +
          "Distance = " + str.tostring(swing_distance2, "#.##") + " bars\n" +
          "Price Difference = " + str.tostring(price_diff2, "#.##") + "\n" +
          "Distance StDev = " + str.tostring(ta.stdev(swing_distance2, length), "#.##") + "\n" +
          "Price StDev = " + str.tostring(ta.stdev(price_diff2, length) / ta.highest(200), "#.##%")

        // Create info text for previous swings
        info_text = "Swing " + str.tostring(i + 1) + ": \n" +
          "Distance = " + str.tostring(swing_distance1, "#.##") + " bars\n" +
          "Price Difference = " + str.tostring(price_diff1, "#.##")

        if extra_swings
            info_text := info_text +
              "\nDistance StDev = " + str.tostring(ta.stdev(swing_distance1, length), "#.##") + "\n" +
              "Price StDev = " + str.tostring(ta.stdev(price_diff1, length) / ta.highest(200), "#.##%")

        // Create and manage labels
        label_y = high_y2
        array.push(_info_labels, label.new(x=high_x2, y=label_y, text=info_text, tooltip=info_tooltip,
          xloc=xloc.bar_index, yloc=yloc.price, color=color.white, style = close > close[1] ? label.style_label_lower_right : label.style_label_upper_right,
          textcolor=color.black, size=size.large))

        if array.size(_info_labels) > labelCount
            label.delete(array.shift(_info_labels))

// // --- Display Metrics ---
// plot(avg_swing_distance, title="Average Swing Distance", display=display.data_window)
// plot(avg_price_diff, title="Average Price Difference", display=display.data_window)
// plot(swing_price_ratio, title="Swing Price Ratio", display=display.data_window)

HarryPlotter(bol, src) =>
    bol ? src : na

swingPlot = input.bool(false)

// --- Display Swing Points ---
plotshape(HarryPlotter(swingPlot, swing_high), style=shape.triangledown, color=color.red, size=size.huge, location=location.abovebar, title="Swing high")
plotshape(HarryPlotter(swingPlot, swing_low), style=shape.triangleup, color=color.green, size=size.huge, location=location.belowbar, title="Swing low")

// // --- Display Divergence Signals ---
// plotshape(bullish_div ? low[0] : na, style=shape.triangleup, color=color.green, size=size.small, location=location.belowbar, title="Bullish Divergence")
// plotshape(bearish_div ? high[0] : na, style=shape.triangledown, color=color.red, size=size.small, location=location.abovebar, title="Bearish Divergence")

// NEW SOURCE \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\

// --- Time and Price Standard Deviation Analysis ---

var high_to_high_times = array.new_int()
var low_to_low_times = array.new_int()
var high_to_low_times = array.new_int()
var low_to_high_times = array.new_int()
var high_to_high_prices = array.new_float()
var low_to_low_prices = array.new_float()
var high_to_low_prices = array.new_float()
var low_to_high_prices = array.new_float()

var prev_high_time = 0
var prev_low_time = 0
var prev_high_price = 0.0
var prev_low_price = 0.0

for i = 1 to length
    if highest_bar_index[i] == 0
        if prev_high_time != 0 and array.size(high_to_high_prices) < 100000
            array.push(high_to_high_times, time[i] - prev_high_time)
            array.push(high_to_high_prices, high[i] - prev_high_price)
        prev_high_time := time[i]
        prev_high_price := high[i]

    if lowest_bar_index[i] == 0
        if prev_low_time != 0 and array.size(low_to_low_prices) < 100000
            array.push(low_to_low_times, time[i] - prev_low_time)
            array.push(low_to_low_prices, low[i] - prev_low_price)
        prev_low_time := time[i]
        prev_low_price := low[i]

        if prev_high_time != 0 and array.size(high_to_low_prices) < 100000
            array.push(high_to_low_times, time[i] - prev_high_time)
            array.push(high_to_low_prices, low[i] - prev_high_price)

    if prev_low_time != 0 and highest_bar_index[i] == 0 and array.size(low_to_high_prices) < 100000
        array.push(low_to_high_times, time[i] - prev_low_time)
        array.push(low_to_high_prices, high[i] - prev_low_price)

std_high_to_high_time = array.stdev(high_to_high_times)
std_low_to_low_time = array.stdev(low_to_low_times)
std_high_to_low_time = array.stdev(high_to_low_times)
std_low_to_high_time = array.stdev(low_to_high_times)
std_high_to_high_price = array.stdev(high_to_high_prices)
std_low_to_low_price = array.stdev(low_to_low_prices)
std_high_to_low_price = array.stdev(high_to_low_prices)
std_low_to_high_price = array.stdev(low_to_high_prices)

// --- Example Probability Calculation (Illustrative) ---

erf(x) =>
    a1 = 0.254829592
    a2 = -0.284496736
    a3 = 1.421413741
    a4 = -1.453152027
    a5 = 1.061405429
    p  = 0.3275911
    sign = x < 0 ? -1 : 1
    x_abs = math.abs(x)
    t = 1.0 / (1.0 + p * x_abs)
    y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * math.exp(-x_abs * x_abs)
    sign * y

cdf(x, mean, std) =>
    0.5 * (1 + erf((x - mean) / (std * math.sqrt(2))))

current_time_diff = time - prev_high_time
z_score = current_time_diff / std_high_to_low_time
p_value = 1 - cdf(z_score, 0, 1)

time_diff_in_interval = z_score * std_high_to_low_time / (timeframe.multiplier * (timeframe.isminutes ? 60000 : timeframe.isdaily? 86400000 : timeframe.isweekly? 604800000: 2592000000 ))

