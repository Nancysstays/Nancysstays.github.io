dow_short_volume = request.security("DOW_SHORT_VOLUME)", timeframe.period, volume)
dow = request.security("DOW", timeframe.period, close)

cov_sec = array.new<float>(0)
cov_dow = array.new<float>(0)
for i = 0 to barsToAnalyze - 1
    array.push(cov_sec, close[i])
    array.push(cov_dow, dow[i])
// Covariance Calculation
covariance_tsla_dow = array.covariance(cov_sec, cov_dow)
