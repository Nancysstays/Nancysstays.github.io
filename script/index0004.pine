// plotshape(short_signal < -1 * entryThreshold and short_signal[1] < -1 * entryThreshold ? h : na, style = shape.labeldown, size = size.huge, location = location.abovebar, color = color.red, title = "short Signal")

entrya = input.bool(true, "Single Signal")
entryb = input.bool(false, "Multiple Signals")
entryc = input.bool(false, "LR 2")
entryd = input.bool(true, "Covariance and MACD")
entrye = input.bool(false, "Swing")
bullEntry = input.bool(false, "Bull")
neutralEntry = input.bool(false, "Neutral")
bearEntry = input.bool(false, "Bear")
// --- Entry and Exit Conditions ---
