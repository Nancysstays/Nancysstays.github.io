// indicator("Double Cosh Curves (with e function)", overlay = true)

// --- Inputs ---

// Length for the highest/lowest range calculation
rangeLength = input.int(100, "Range Length")

// Standard deviation multiplier for the first cosh curve
stdDevMult1 = input.float(1.0, "StdDev Multiplier 1")

// Standard deviation multiplier for the second cosh curve
stdDevMult2 = input.float(2.0, "StdDev Multiplier 2")

// --- Calculations ---

// Calculate the highest and lowest price over the specified range
highestHigh = ta.highest(high, length)
lowestLow = ta.lowest(low, length)

// Calculate the standard deviation of the price over the specified range
priceStdDev = ta.stdev(close, rangeLength)

// Calculate the x-coordinate for the cosh curves (scaled to the price range)
x = (close - lowestLow) / (highestHigh - lowestLow)

// Calculate the y-coordinates for the cosh curves using the exponential function
y1 = (math.exp(x * stdDevMult1) + math.exp(-x * stdDevMult1)) / 2
y2 = (math.exp(x * stdDevMult2) + math.exp(-x * stdDevMult2)) / 2

// Scale the y-coordinates to the price range
scaledY1 = y1 * priceStdDev
scaledY2 = y2 * priceStdDev

// --- Plotting ---

// Plot the first cosh curve
plot(y1, color = color.blue, linewidth = 2, title = "Cosh Curve 1", display = display.data_window)
// Plot the second cosh curve
plot(y2, color = color.red, linewidth = 2, title = "Cosh Curve 2", display = display.data_window)

