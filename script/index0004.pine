addRow(table, col, texta, textb, textc, textd, bga, bgb, bgc) =>
    // Populate the table with probability values
    table.cell(table, col, 0, texta, bgcolor = bga)
    table.cell(table, col, 1, str.tostring(textb, ".###"), bgcolor=bga)
    table.cell(table, col, 2, textc, bgcolor = bgb)
    table.cell(table, col, 3, str.tostring(textd, ".###"), bgcolor=bga)
    // table.cell(table, col, 2, "")
    // table.cell(table, col, 5, "")

prob(float numerator_value, float denominator_value, int idx = 0) =>
    // p_uuu = a / ( b == 0 ? 1 : b)
    // switch idx
    //     1 => local_block_1
    //     2 => local_block_2
    //     => default_local_block
    numerator_value / ( denominator_value == 0 ? 1 : denominator_value)

// --- Main script ---

// Loop through each symbol
for symbolIndex = 0 to array.size(symbols) - 1
    // Get the symbol
    symbol = array.get(symbols, symbolIndex)

    // Loop through each timeframe
    for timeframeIndex = 0 to array.size(timeframes) - 1
        // Get the timeframe
        timeframe = array.get(timeframes, timeframeIndex)

        // Request security data
        lower_tf_data = request.security(symbol, timeframe, close)

        // // Reset counters for each symbol and timeframe
        // uCount := 0
        // dddddCount := 0

        // Counts aCounts = Counts.new(0)
        // Calculate probabilities directly within the loop
        for i = 5 to barsToAnalyze - 1 + 5
            // Get current and previous closing prices
            c_curr = lower_tf_data[i - 5]
            c_prev = lower_tf_data[i - 4]
            c_prev_prev = lower_tf_data[i - 3]
            c_prev_prev_prev = lower_tf_data[i - 2]
            c_prev_prev_prev_prev = lower_tf_data[i - 1]
            c_prev_prev_prev_prev_prev = lower_tf_data[i]

            // Increment counters based on price movements
            if c_curr > c_prev
                uCount := uCount + 1
                if c_prev > c_prev_prev
                    uuCount := uuCount + 1
                    if c_prev_prev > c_prev_prev_prev
                        uuuCount := uuuCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            uuuuCount := uuuuCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                uuuuuCount := uuuuuCount + 1
                            else
                                uuuudCount := uuuudCount + 1
                        else
                            uuudCount := uuudCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                uuuduCount := uuuduCount + 1
                            else
                                uuuddCount := uuuddCount + 1
                    else
                        uudCount := uudCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            uuduCount := uuduCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                uuduuCount := uuduuCount + 1
                            else
                                uududCount := uududCount + 1
                        else
                            uuddCount := uuddCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                uudduCount := uudduCount + 1
                            else
                                uudddCount := uudddCount + 1
                else
                    udCount := udCount + 1
                    if c_prev_prev > c_prev_prev_prev
                        uduCount := uduCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            uduuCount := uduuCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                uduuuCount := uduuuCount + 1
                            else
                                uduudCount := uduudCount + 1
                        else
                            ududCount := ududCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                ududuCount := ududuCount + 1
                            else
                                ududdCount := ududdCount + 1
                    else
                        uddCount := uddCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            udduCount := udduCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                udduuCount := udduuCount + 1
                            else
                                uddudCount := uddudCount + 1
                        else
                            udddCount := udddCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                uddduCount := uddduCount + 1
                            else
                                uddddCount := uddddCount + 1
            else
                dCount := dCount + 1
                if c_prev > c_prev_prev
                    duCount := duCount + 1
                    if c_prev_prev > c_prev_prev_prev
                        duuCount := duuCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            duuuCount := duuuCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                duuuuCount := duuuuCount + 1
                            else
                                duuudCount := duuudCount + 1
                        else
                            duudCount := duudCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                duuduCount := duuduCount + 1
                            else
                                duuddCount := duuddCount + 1
                    else
                        dudCount := dudCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            duduCount := duduCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                duduuCount := duduuCount + 1
                            else
                                dududCount := dududCount + 1
                        else
                            duddCount := duddCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                dudduCount := dudduCount + 1
                            else
                                dudddCount := dudddCount + 1
                else
                    ddCount := ddCount + 1
                    if c_prev_prev > c_prev_prev_prev
                        dduCount := dduCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            dduuCount := dduuCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                dduuuCount := dduuuCount + 1
                            else
                                dduudCount := dduudCount + 1
                        else
                            ddudCount := ddudCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                dduduCount := dduduCount + 1
                            else
                                dduddCount := dduddCount + 1
                    else
                        dddCount := dddCount + 1
                        if c_prev_prev_prev > c_prev_prev_prev_prev
                            ddduCount := ddduCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                ddduuCount := ddduuCount + 1
                            else
                                dddudCount := dddudCount + 1
                        else
                            ddddCount := ddddCount + 1
                            if c_prev_prev_prev_prev > c_prev_prev_prev_prev_prev
                                dddduCount := dddduCount + 1
                            else
                                dddddCount := dddddCount + 1

        // Calculate and display probabilities
        p_u := prob(uCount, barsToAnalyze - 1)
        p_d := prob(dCount, barsToAnalyze - 1)
        p_uu := prob(uuCount, uCount)
        p_ud := prob(udCount, uCount)
        p_du := prob(duCount, dCount)
        p_dd := prob(ddCount, dCount)
        p_uuu := prob(uuuCount, uuCount)
        p_uud := prob(uudCount, uuCount)
        p_udu := prob(uduCount, udCount)
        p_udd := prob(uddCount, udCount)
        p_duu := prob(duuCount, duCount)
        p_dud := prob(dudCount, duCount)
        p_ddu := prob(dduCount, ddCount)
        p_ddd := prob(dddCount, ddCount)
        p_uuuu := prob(uuuuCount, uuuCount)
        p_uuud := prob(uuudCount, uuuCount)
        p_uudu := prob(uuduCount, uudCount)
        p_uudd := prob(uuddCount, uudCount)
        p_uduu := prob(uduuCount, uduCount)
        p_udud := prob(ududCount, uduCount)
        p_uddu := prob(udduCount, uddCount)
        p_uddd := prob(udddCount, uddCount)
        p_duuu := prob(duuuCount, duuCount)
        p_duud := prob(duudCount, duuCount)
        p_dudu := prob(duduCount, dudCount)
        p_dudd := prob(duddCount, dudCount)
        p_dduu := prob(dduuCount, dduCount)
        p_ddud := prob(ddudCount, dduCount)
        p_dddu := prob(ddduCount, dddCount)
        p_dddd := prob(ddddCount, dddCount)
        p_uuuuu := prob(uuuuuCount, uuuuCount)
        p_uuuud := prob(uuuudCount, uuuuCount)
        p_uuudu := prob(uuuduCount, uuudCount)
        p_uuudd := prob(uuuddCount, uuudCount)
        p_uuduu := prob(uuduuCount, uuduCount)
        p_uudud := prob(uududCount, uuduCount)
        p_uuddu := prob(uudduCount, uuddCount)
        p_uuddd := prob(uudddCount, uuddCount)
        p_uduuu := prob(uduuuCount, uduuCount)
        p_uduud := prob(uduudCount, uduuCount)
        p_ududu := prob(ududuCount, ududCount)
        p_ududd := prob(ududdCount, ududCount)
        p_udduu := prob(udduuCount, udduCount)
        p_uddud := prob(uddudCount, udduCount)
        p_udddu := prob(uddduCount, udddCount)
        p_udddd := prob(uddddCount, udddCount)
        p_duuuu := prob(duuuuCount, duuuCount)
        p_duuud := prob(duuudCount, duuuCount)
        p_duudu := prob(duuduCount, duudCount)
        p_duudd := prob(duuddCount, duudCount)
        p_duduu := prob(duduuCount, duduCount)
        p_dudud := prob(dududCount, duduCount)
        p_duddu := prob(dudduCount, duddCount)
        p_duddd := prob(dudddCount, duddCount)
        p_dduuu := prob(dduuuCount, dduuCount)
        p_dduud := prob(dduudCount, dduuCount)
        p_ddudu := prob(dduduCount, ddudCount)
        p_ddudd := prob(dduddCount, ddudCount)
        p_ddduu := prob(ddduuCount, ddduCount)
        p_dddud := prob(dddudCount, ddduCount)
        p_ddddu := prob(dddduCount, ddddCount)
        p_ddddd := prob(dddddCount, ddddCount)
        
        var bg_color = color.new(color.white, 10)
        var posit = ""
        // Create a table to display the probabilities
        if showProbTable
            posit := position.bottom_center
        else
            posit := position.bottom_left
        var table probTable = table.new(posit, 15, 4, border_width=1)

        if showProbTable or showProbTable2
            // Set table header
            table.cell(probTable, 0, 0, "Probability", tooltip =  "P(U|*)", bgcolor=color.gray, text_color=color.white)
            table.cell(probTable, 0, 1, "Value", bgcolor=color.gray, text_color=color.white)
            // table.cell(probTable, 0, 2, "Count", bgcolor=color.gray, text_color=color.white)
            table.cell(probTable, 0, 2, "Probability", tooltip =  "P(D|*)", bgcolor=color.gray, text_color=color.white)
            table.cell(probTable, 0, 3, "Value", bgcolor=color.gray, text_color=color.white)
            // table.cell(probTable, 0, 5, "Count", bgcolor=color.gray, text_color=color.white)

        var bool bg1 = bg(0)
        var bool bg2 =  bg(1)
        var bool bg3 =  bg(2)
        var bool bg4 =  bg(3)

        var color active = color.new(color.yellow, 10)
        var color inactive = color.new(color.white, 10)

        var color bgcolorUU = cl > o and cl[1] > o[1] ? active : inactive
        var color bgcolorUD = cl < o and cl[1] > o[1] ? active : inactive
        var color bgcolorDU = cl > o and cl[1] < o[1] ? active : inactive
        var color bgcolorDD = cl < o and cl[1] < o[1] ? active : inactive

        var color bgcolorUUU = cl > o and cl[1] > o[1] and cl[2] > o[2] ? active : inactive
        var color bgcolorUUD = cl > o and cl[1] > o[1] and cl[2] < o[2] ? active : inactive
        var color bgcolorUDU = cl < o and cl[1] > o[1] and cl[2] > o[2] ? active : inactive
        var color bgcolorUDD = cl < o and cl[1] > o[1] and cl[2] < o[2] ? active : inactive
        var color bgcolorDUU = cl > o and cl[1] < o[1] and cl[2] > o[2] ? active : inactive
        var color bgcolorDUD = cl > o and cl[1] < o[1] and cl[2] < o[2] ? active : inactive
        var color bgcolorDDU = cl < o and cl[1] < o[1] and cl[2] > o[2] ? active : inactive
        var color bgcolorDDD = cl < o and cl[1] < o[1] and cl[2] < o[2] ? active : inactive

        var color bgcolorUUUU = bg1 and bg2 and bg3 and bg4 ? active : inactive
        var color bgcolorUUUD = bg1 and bg2 and bg3 and not bg4 ? active : inactive
        var color bgcolorUUDU = bg1 and bg2 and not bg3 and bg4 ? active : inactive
        var color bgcolorUUDD = bg1 and bg2 and not bg3 and not bg4 ? active : inactive
        var color bgcolorUDUU = bg1 and not bg2 and bg3 and bg4 ? active : inactive
        var color bgcolorUDUD = bg1 and not bg2 and bg3 and not bg4 ? active : inactive
        var color bgcolorUDDU = bg1 and not bg2 and not bg3 and bg4 ? active : inactive
        var color bgcolorUDDD = bg1 and not bg2 and not bg3 and not bg4 ? active : inactive
        var color bgcolorDUUU = not bg1 and bg2 and bg3 and bg4 ? active : inactive
        var color bgcolorDUUD = not bg1 and bg2 and bg3 and not bg4 ? active : inactive
        var color bgcolorDUDU = not bg1 and bg2 and not bg3 and bg4 ? active : inactive
        var color bgcolorDUDD = not bg1 and bg2 and not bg3 and not bg4 ? active : inactive
        var color bgcolorDDUU = not bg1 and not bg2 and bg3 and bg4 ? active : inactive
        var color bgcolorDDUD = not bg1 and not bg2 and bg3 and not bg4 ? active : inactive
        var color bgcolorDDDU = not bg1 and not bg2 and not bg3 and bg4 ? active : inactive
        var color bgcolorDDDD = not bg1 and not bg2 and not bg3 and not bg4 ? active : inactive

        if showProbTable
            // Populate the table with probability values
            addRow(probTable, 1, "p_uu", p_uu, "p_ud", p_ud, bg_color, bgcolorUU, bgcolorUD)
            addRow(probTable, 2, "p_du", p_du, "p_dd", p_dd, bg_color, bgcolorDU, bgcolorDD)
            addRow(probTable, 3, "p_uuu", p_uuu, "p_uud", p_uud, bg_color, bgcolorUUU, bgcolorUUD)
            addRow(probTable, 4, "p_udu", p_udu, "p_udd", p_udd, bg_color, bgcolorUDU, bgcolorUDD)
            addRow(probTable, 5, "p_duu", p_duu, "p_dud", p_dud, bg_color, bgcolorDUU, bgcolorDUD)
            addRow(probTable, 6, "p_ddu", p_ddu, "p_ddd", p_ddd, bg_color, bgcolorDDU, bgcolorDDD)

